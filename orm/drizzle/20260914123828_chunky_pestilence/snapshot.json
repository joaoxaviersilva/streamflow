      "definition": "select `p`.`id` AS `perfil_id`,'CONFIDENCIAL' AS `nome`,concat(left(`a`.`email`,2),'***@',substring_index(`a`.`email`,'@',-1)) AS `email_mascarado`,'***.***.***-**' AS `cpf`,`calcular_idade`(`a`.`data_nascimento`) AS `idade`,`a`.`uf` AS `uf`,count(`l`.`id`) AS `total_reproducoes`,coalesce(sum(`l`.`tempo_assistido_minutos`),0) AS `minutos_consumidos` from ((`streamflow`.`assinantes` `a` join `streamflow`.`perfis` `p` on(`p`.`assinante_id` = `a`.`id`)) left join `streamflow`.`logs_reproducao` `l` on(`l`.`perfil_id` = `p`.`id`)) group by `p`.`id`,`a`.`data_nascimento`,`a`.`uf`,`a`.`email`",
